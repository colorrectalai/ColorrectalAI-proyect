# Modelo de segmentación (máscaras). Para volver al de cajas: modelos/best.onnx y baseline-0.1
MODELO_RUTA=modelos/best_seg.onnx
MODELO_URL=
MODELO_SHA256=
MODELO_VERSION=seg-0.1
UMBRAL_CONF=0.25
TAMANO_IMG=640
CORS_ORIGENES=http://localhost:5173
MAX_MB_IMAGEN=10
MAX_CONCURRENTES=2
ESPERA_MAX_S=20

# Base de datos (opcional). Sin ella la API funciona, pero no guarda registros ni permite crear cuentas.
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Clave para firmar las sesiones de usuario. En producción: un valor largo y aleatorio, secreto.
TOKEN_SECRETO=
TOKEN_HORAS=8
